<%# locals: (schedule:, can_write:) %>
<%# The weeks to drop specials on, replaced whole (a morph) after every drop. Each week's days run
    two to a row. special-builder--board (around it) posts a drop to placements. %>
<section id="special_builder_board" class="<%= ui(:panel, "space-y-4 p-4") %>">
  <div class="flex flex-wrap items-center justify-between gap-2">
    <div>
      <h2 class="<%= ui(:heading) %>">Week by week</h2>
      <p class="<%= ui(:help) %>"><%= schedule.from.strftime("%B %-d") %> – <%= schedule.to.strftime("%B %-d, %Y") %></p>
    </div>
    <div class="flex items-center gap-1">
      <%= link_to "‹ Earlier", special_builder_board_path(week: (schedule.from - 7 * schedule.weeks).iso8601), class: ui(:button, :small) %>
      <%= link_to "This week", special_builder_board_path, class: ui(:button, :small) %>
      <%= link_to "Later ›", special_builder_board_path(week: (schedule.to + 1).iso8601), class: ui(:button, :small) %>
    </div>
  </div>
  <% schedule.weeks_of_lineups.each do |lineups| %>
    <%# herb:key lineups.first.date %>
    <div class="space-y-2">
      <h3 class="text-xs font-medium text-gray-500">Week of <%= lineups.first.date.strftime("%B %-d") %> · week <%= lineups.first.date.cweek %></h3>
      <div class="grid grid-cols-1 gap-2 sm:grid-cols-2">
        <% lineups.each do |lineup| %>
          <%# herb:key lineup.date %>
          <%= render "special_builder/boards/cell", slot: SpecialBuilder::Slot.on(lineup.date),
                heading: lineup.date.strftime("%A %-d %B"), entries: lineup.entries, customised: lineup.customised,
                today: lineup.date == SpecialBuilder.today, can_write: can_write, week: schedule.from %>
        <% end %>
      </div>
    </div>
  <% end %>
</section>
