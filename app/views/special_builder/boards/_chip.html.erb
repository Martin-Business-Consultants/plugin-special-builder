<%# locals: (entry:, can_write:, week:, slot: nil, faded: false) %>
<%# A special to drag: from the list (a copy) or from a day (a move, `slot` saying which), with
    its price, and on a day a button to take it off. %>
<% price = entry.frontmatter.is_a?(Hash) ? entry.frontmatter["price"].to_s.strip.presence : nil %>
<div class="<%= class_names("special-builder-chip flex items-start justify-between gap-1 rounded-md border border-gray-200 bg-white px-2 py-1.5 text-xs",
       "cursor-grab": can_write, "opacity-60": faded) %>"
     draggable="<%= can_write %>"
     data-entry-id="<%= entry.id %>"
     data-from="<%= slot&.to_param&.to_json %>"
     data-action="dragstart->special-builder--board#dragStart dragend->special-builder--board#dragEnd"
     title="<%= faded ? "Every week's: drag or remove it to change this week only" : entry.title %>">
  <span class="min-w-0">
    <span class="block font-medium text-gray-900"><%= entry.title %></span>
    <% if price || entry.status != "published" %>
      <span class="block text-gray-500"><%= [price, (entry.status unless entry.status == "published")].compact.join(" · ") %></span>
    <% end %>
  </span>
  <% if can_write && slot %>
    <%= button_to special_builder_placement_path(entry, **slot.to_param, week: week.iso8601), method: :delete,
          class: "shrink-0 text-gray-500 hover:text-gray-900", title: "Take #{entry.title} off #{slot.label}" do %>
      <%= icon_tag "close", class: "size-3" %>
      <span class="sr-only">Take <%= entry.title %> off <%= slot.label %></span>
    <% end %>
  <% end %>
</div>
